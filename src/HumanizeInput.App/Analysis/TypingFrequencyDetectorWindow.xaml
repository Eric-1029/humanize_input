<Window x:Class="HumanizeInput.App.Analysis.TypingFrequencyDetectorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding WindowTitle}" Height="760" Width="1000" MinHeight="400" MinWidth="420"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#EDF3F9"
 FontFamily="Segoe UI" FontSize="13" Foreground="#172C43" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#FAFFFFFF"/><Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StatusText}" Margin="0,6,0,12" Foreground="#52647B" TextWrapping="Wrap"/>
      <WrapPanel>
       <Button Content="{Binding PromptLanguageToggleText}" Command="{Binding TogglePromptLanguageCommand}" Margin="0,0,8,6"/>
       <Button Content="{Binding ResetButtonText}" Command="{Binding ResetCommand}" Margin="0,0,0,6"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <WrapPanel x:Name="DetectorColumns" SizeChanged="OnColumnsSizeChanged" ItemWidth="450" Margin="0,0,-12,0">
     <StackPanel Margin="0,0,12,0">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="{Binding PromptSectionTitle}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding PromptLanguageName}" Foreground="#52647B" Margin="0,4,0,10"/>
        <TextBlock Text="{Binding PromptText}" TextWrapping="Wrap" FontSize="16" LineHeight="26"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="{Binding InputSectionTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="TypingAreaBox" Text="{Binding TypedText, UpdateSourceTrigger=PropertyChanged}"
          AcceptsReturn="True" AcceptsTab="True" IsEnabled="{Binding IsRecording}" Height="230"
          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"
          FontSize="15" Padding="12" AutomationProperties.Name="{Binding InputSectionTitle}"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Margin="0,0,12,0">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="{Binding MetricsSectionTitle}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding LiveMetricsText}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="{Binding ResultSectionTitle}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ResultSummaryText}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </WrapPanel>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12">
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="{Binding CloseButtonText}" Click="OnCloseClick" Margin="0,2,6,2"/>
    <Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureToggleCommand}" Click="OnCaptureButtonClick" Margin="0,2,6,2"/>
    <Button Content="{Binding ApplyButtonText}" IsEnabled="{Binding CanApply}" Click="OnApplyClick"
      Background="#236B59" Foreground="White" Margin="0,2,0,2"/>
   </WrapPanel>
  </Border>
 </Grid>
</Window>
