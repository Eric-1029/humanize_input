<UserControl x:Class="HumanizeInput.App.Controls.ParameterEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
 <UserControl.Resources>
  <ControlTemplate x:Key="SliderDecreaseButtonTemplate" TargetType="RepeatButton">
   <Border Height="5" Background="#2E8068" CornerRadius="2.5"/>
  </ControlTemplate>
  <ControlTemplate x:Key="SliderIncreaseButtonTemplate" TargetType="RepeatButton">
   <Border Height="5" Background="#C5D2DC" CornerRadius="2.5"/>
  </ControlTemplate>
  <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
   <Border Width="18" Height="18" CornerRadius="9"
           Background="#FFFFFF" BorderBrush="#236B59" BorderThickness="2"/>
  </ControlTemplate>
  <Style x:Key="ParameterSliderStyle" TargetType="Slider">
   <Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="96"/>
   <Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track" Margin="9,0" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                       Focusable="False"
                       Template="{StaticResource SliderDecreaseButtonTemplate}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                       Focusable="False"
                       Template="{StaticResource SliderIncreaseButtonTemplate}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
         <Thumb x:Name="SliderThumb" Template="{StaticResource SliderThumbTemplate}"/>
        </Track.Thumb>
       </Track>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="PART_Track" Property="Opacity" Value="0.45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="0,8,0,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
  <TextBlock Grid.ColumnSpan="2" Text="{Binding Label, ElementName=Root}" TextWrapping="Wrap" Margin="0,0,0,4"/>
  <Slider x:Name="ValueSlider" Grid.Row="1" Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}"
    Value="{Binding Value, ElementName=Root, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"
    Style="{StaticResource ParameterSliderStyle}"
    VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
  <TextBox x:Name="NumberBox" Grid.Row="1" Grid.Column="1"
   TextAlignment="Right" VerticalContentAlignment="Center"
   LostKeyboardFocus="OnCommit"
   GotKeyboardFocus="OnNumberBoxGotKeyboardFocus"
   PreviewMouseLeftButtonDown="OnNumberBoxPreviewMouseLeftButtonDown"
   PreviewKeyDown="OnKeyDown"
   AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding RangeText, ElementName=Root}"
   Foreground="#596A80" FontSize="11" Margin="0,4,0,0"/>
 </Grid>
</UserControl>
