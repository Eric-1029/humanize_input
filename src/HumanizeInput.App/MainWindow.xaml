<Window x:Class="HumanizeInput.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:HumanizeInput.App.Controls"
 Title="{Binding UiWindowTitle}" Icon="Assets/humanized_input_logo.ico"
 Width="1060" Height="820" MinWidth="420" MinHeight="400"
 WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
 Background="#01000000" FontFamily="Segoe UI" FontSize="13" Foreground="#172C43"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#D9FFFFFF"/><Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#90FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
 </Window.Resources>
 <Border Background="#DEEDF3F9" BorderBrush="#BFFFFFFF" BorderThickness="1" CornerRadius="18" Padding="16" Margin="4">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="Transparent" MouseLeftButtonDown="OnTitleMouseDown" Padding="4,10">
     <TextBlock Text="humanize_input" FontSize="17" FontWeight="SemiBold" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Content="{Binding LanguageToggleButtonText}" Command="{Binding ToggleLanguageCommand}" ToolTip="{Binding LanguageLabelText}"/>
     <Button x:Name="SettingsMenuButton" Content="⚙" ToolTip="{Binding SettingsButtonText}" Click="OnSettingsMenuButtonClick" AutomationProperties.Name="{Binding SettingsButtonText}"/>
     <Button Content="−" Click="OnMinimizeClick" ToolTip="{Binding MinimizeText}"/>
     <Button Content="□" Click="OnMaximizeClick" ToolTip="{Binding MaximizeText}"/>
     <Button Content="×" Click="OnHideClick" ToolTip="{Binding HideWindowText}"/>
    </StackPanel>
    <Popup x:Name="SettingsPopup"
                               PlacementTarget="{Binding ElementName=SettingsMenuButton}"
                               Placement="Bottom"
                               VerticalOffset="8"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#FFFFFF" BorderBrush="#CCD7E2" BorderThickness="1" CornerRadius="10" Padding="12">
                                <ScrollViewer MaxHeight="300"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Width="320">
                                    <TextBlock Text="{Binding SettingsMenuTitleText}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding StartHotkeyLabelText}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding StartHotkeyText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding HotkeyExampleTooltipText}" Margin="0,2,0,6"/>

                                    <TextBlock Text="{Binding PauseHotkeyLabelText}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding PauseHotkeyText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding HotkeyExampleTooltipText}" Margin="0,2,0,8"/>

                                    <TextBlock Text="{Binding CancelHotkeyLabelText}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding CancelHotkeyText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding HotkeyExampleTooltipText}" Margin="0,2,0,8"/>

                                    <Button Content="{Binding ApplyHotkeysButtonText}" Width="108" Height="30" HorizontalAlignment="Left" Command="{Binding ApplyHotkeysCommand}" Margin="0,0,0,8"/>

                                    <Separator Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding LanguageLabelText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentLanguageName}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="{Binding LanguageToggleButtonText}" Width="62" Height="28" Command="{Binding ToggleLanguageCommand}"/>
                                    </StackPanel>

                                    <Separator Margin="0,10,0,8"/>

                                    <Button Content="{Binding TypingDetectorButtonText}"
                                            Width="240"
                                            Height="30"
                                            Click="OnOpenTypingDetectorClick"/>
                                    <Separator Margin="0,10,0,8"/>

                                    <TextBlock Text="{Binding AboutSectionTitleText}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding AppNameText}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding AppDescriptionText}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding AppTechStackText}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#5B6570"/>

                                    <TextBlock Text="{Binding GitHubProfileLabelText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding GitHubProfileValueText}" Margin="0,2,0,4"/>
                                    <Button Content="{Binding OpenGitHubProfileButtonText}" Height="30" Margin="0,0,0,8" Click="OnOpenGitHubProfileClick"/>

                                    <TextBlock Text="{Binding GitHubRepositoryLabelText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding GitHubRepositoryValueText}" Margin="0,2,0,4"/>
                                    <Button Content="{Binding OpenRepositoryButtonText}" Height="30" Click="OnOpenGitHubRepositoryClick"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="{Binding InputSectionTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
       <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
        Height="180" TextWrapping="Wrap" FontSize="14" Padding="12" AutomationProperties.Name="{Binding InputSectionTitle}"/>
      </StackPanel>
     </Border>
     <WrapPanel x:Name="ParameterCards" SizeChanged="OnParameterCardsSizeChanged" ItemWidth="310" Margin="0,0,-12,0">
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding TypingRhythmSectionTitle}" FontSize="15" FontWeight="SemiBold"/>
<controls:ParameterEditor Label="{Binding BaseDelayLabelText}" Value="{Binding BaseDelayMs, Mode=TwoWay}" Minimum="20" Maximum="500" RangeText="20 – 500 ms"/>
<controls:ParameterEditor Label="{Binding JitterLabelText}" Value="{Binding JitterPercent, Mode=TwoWay}" Minimum="0" Maximum="80" RangeText="0 – 80 %"/>
<controls:ParameterEditor Label="{Binding LeadInLabelText}" Value="{Binding LeadInDelayMs, Mode=TwoWay}" Minimum="0" Maximum="6000" RangeText="0 – 6000 ms"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding ErrorSimulationSectionTitle}" FontSize="15" FontWeight="SemiBold"/>
<controls:ParameterEditor Label="{Binding TypoRateLabelText}" Value="{Binding TypoRatePercent, Mode=TwoWay}" Minimum="0" Maximum="30" RangeText="0 – 30 %"/>
<controls:ParameterEditor Label="{Binding OmissionRateLabelText}" Value="{Binding OmissionRatePercent, Mode=TwoWay}" Minimum="0" Maximum="30" RangeText="0 – 30 %"/>
<controls:ParameterEditor Label="{Binding TransposeRateLabelText}" Value="{Binding TransposeRatePercent, Mode=TwoWay}" Minimum="0" Maximum="20" RangeText="0 – 20 %"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding CorrectionSectionTitle}" FontSize="15" FontWeight="SemiBold"/>
<controls:ParameterEditor Label="{Binding RepairRateLabelText}" Value="{Binding RepairRatePercent, Mode=TwoWay}" Minimum="0" Maximum="100" RangeText="0 – 100 %"/>
<controls:ParameterEditor Label="{Binding ErrorDetectDelayLabelText}" Value="{Binding ErrorDetectDelayMs, Mode=TwoWay}" Minimum="80" Maximum="3000" RangeText="80 – 3000 ms"/>
<controls:ParameterEditor Label="{Binding BackspaceDelayLabelText}" Value="{Binding BackspaceDelayMs, Mode=TwoWay}" Minimum="10" Maximum="500" RangeText="10 – 500 ms"/>
</StackPanel></Border>
     </WrapPanel>
     <WrapPanel Margin="0,0,0,12">
      <Button Content="{Binding TypingDetectorButtonText}" Click="OnOpenTypingDetectorClick"/>
      <TextBlock Text="{Binding TrayHintText}" TextWrapping="Wrap" MaxWidth="320" Foreground="#52647B" Margin="8,6"/>
     </WrapPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#EEFFFFFF" CornerRadius="12" Padding="12" Margin="0,10,0,0">
    <StackPanel>
     <WrapPanel>
      <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}" Background="#236B59" Foreground="White" ToolTip="{Binding StartHotkeyText}"/>
      <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" ToolTip="{Binding PauseHotkeyText}"/>
      <Button Content="{Binding CancelButtonText}" Click="OnCancelClick" ToolTip="{Binding CancelHotkeyText}"/>
     </WrapPanel>
     <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="3,6,3,2"/>
       <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="#52647B" FontSize="11" Margin="3,0"/>
      </StackPanel>
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</Window>
